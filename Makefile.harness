	@echo "=========================================="
	@echo "Phase 07: Iterate (N agents, one per feedback spec, on-demand)"
	@echo "=========================================="
	@echo ""
	@echo "Phase 07-03 roster: docs/PHASE-07-03.md"
	@echo ""
	@echo "Cursor Cloud Agent prompts (one agent per spec):"
	@echo "  docs/ai-product-slice-harness/cloud-agents/phase-07-session-audio-archive-export-import.md"
	@echo "  docs/ai-product-slice-harness/cloud-agents/phase-07-debug-export-session-download.md"
	@echo "  docs/ai-product-slice-harness/cloud-agents/phase-07-playback-upload-session-archive.md"
	@echo "  docs/ai-product-slice-harness/cloud-agents/phase-07-volume-analyzer-upload-session-archive.md"
