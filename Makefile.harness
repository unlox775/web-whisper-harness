	@echo "Order: spec 1 (session-store archive) FIRST (serial). Then specs 2/3/4/5 in parallel."
	@echo ""
	@echo "ERROR: This repository uses Cursor Cloud Agents, not Codex."
	@echo "Do NOT run 'codex exec'. Launch Cursor Cloud Agents manually instead."
	@echo ""
	@exit 1

phase-7-serial:
	@echo "=========================================="
	@echo "Phase 07 Serial: Iterate one product at a time"
	@echo "=========================================="
	@echo ""
	@echo "Recommended serial order (Phase 07-03):"
	@echo "  1. phase-07-session-audio-archive-export-import.md   (MUST be first)"
	@echo "  2. phase-07-debug-export-session-download.md        (after 1; parallel with 3/4/5)"
	@echo "  3. phase-07-playback-upload-session-archive.md"
	@echo "  4. phase-07-volume-analyzer-upload-session-archive.md"
	@echo "  5. phase-07-transcription-upload-session-archive.md"
	@echo ""
	@echo "ERROR: This repository uses Cursor Cloud Agents, not Codex."
	@echo "Do NOT run 'codex exec'. Launch Cursor Cloud Agents manually instead."
	@echo ""
	@exit 1

phase-7-dry-run:
	@echo "=========================================="
	@echo "Phase 07 Dry Run: Preview unresolved Phase 07 specs"
	@echo "=========================================="
	@echo ""
	@echo "Unresolved Phase 07-03 feedback specs:"
	@echo "  packages/datastore/session-store/docs/specs/20260904180001-feedback-session-audio-archive-export-import.md"
	@echo "  apps/web-whisper-pwa/docs/specs/20260904180002-feedback-debug-export-session-download.md"
	@echo "  packages/lib/playback-engine/docs/specs/20260904180003-feedback-isolation-demo-upload-session-archive-as-play-source.md"
	@echo "  packages/lib/volume-analyzer/docs/specs/20260904180004-feedback-isolation-demo-upload-session-archive-as-analyze-source.md"
	@echo "  packages/lib/transcription-client/docs/specs/20260904180005-feedback-isolation-demo-upload-session-archive-as-transcribe-source.md"
	@echo ""
	@echo "See docs/PHASE-07-03.md for dependency order (1 serial, then 2/3/4/5 parallel)."
	@echo ""
	@echo "This repository uses Cursor Cloud Agents, not Codex."
	@echo ""
	@exit 1

phase-7-notes:
	@if [ -n "$(strip $(RUN_ID))" ]; then \
		python3 scripts/generate-phase-07-notes.py "$(RUN_ID)"; \
	else \
		python3 scripts/generate-phase-07-notes.py; \
	fi

phase-ra-3:
	$(REARCH_ENV) $(RUN_ENV) bash subagents/phase-ra-03-product-specs.sh $(ARGS)

phase-ra-4:
	$(REARCH_ENV) $(RUN_ENV) bash subagents/phase-ra-04-customer-requests.sh $(ARGS)

phase-ra-5:
	$(REARCH_ENV) $(RUN_ENV) bash subagents/phase-ra-05-producer-responses.sh $(ARGS)

phase-ra-6:
	$(REARCH_ENV) $(RUN_ENV) bash subagents/phase-ra-06-implementation.sh $(ARGS)

phase-ra-complete:
	$(REARCH_ENV) $(RUN_ENV) bash subagents/phase-ra-07-complete.sh $(ARGS)

phase-ra-abandon:
	$(REARCH_ENV) bash subagents/phase-ra-abandon.sh

watch:
	$(RUN_ENV) bash docs/ai-product-slice-harness/watch-phase.sh "$(PHASE)" "$(LINES)" "$(INTERVAL)"

status:
	@if [ "$(PHASE)" = "auto" ] && [ -f "subagents/status/current-phase" ]; then \
		active_phase="$$(sed -n '1p' subagents/status/current-phase)"; \
		active_run="$$(sed -n '2p' subagents/status/current-phase)"; \
		if [ -n "$$active_run" ]; then \
			PHASE_RUN_ID="$$active_run" bash subagents/phase-status.sh "$$active_phase" --verbose; \
		else \
			bash subagents/phase-status.sh "$$active_phase" --verbose; \
		fi; \
	elif [ "$(PHASE)" = "auto" ]; then \
		echo "No harness phase has started yet."; \
	elif [ -n "$(strip $(RUN_ID))" ]; then \
		PHASE_RUN_ID="$(RUN_ID)" bash subagents/phase-status.sh "$(PHASE)" --verbose; \
	elif [ -f "subagents/status/$(PHASE).latest-run" ]; then \
		PHASE_RUN_ID="$$(sed -n '1p' "subagents/status/$(PHASE).latest-run")" bash subagents/phase-status.sh "$(PHASE)" --verbose; \
	else \
		bash subagents/phase-status.sh "$(PHASE)" --verbose; \
	fi
