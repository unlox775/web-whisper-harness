	@echo "=========================================="
	@echo ""
	@echo "This target would run Phases 03, 04, and 05 in sequence using Codex."
	@echo "This repository uses Cursor Cloud Agents instead."
	@echo ""
	@echo "Manual workflow:"
	@echo "  1. Run Phase 03 manually (see 'make phase-3' for prompts)"
	@echo "  2. After Phase 03 completes, merge to main"
	@echo "  3. Run Phase 04 manually (see 'make phase-4' for prompts)"
	@echo "  4. After Phase 04 completes, merge to main"
	@echo "  5. Run Phase 05 manually (see 'make phase-5' for prompts)"
	@echo "  6. After Phase 05 completes, merge to main"
	@echo ""
	@echo "ERROR: This repository uses Cursor Cloud Agents, not Codex."
