PHASE ?= auto
LINES ?= 5
INTERVAL ?= 1
ARGS ?=
RUN_ID ?=
REARCH_ID ?=

ifeq ($(strip $(RUN_ID)),)
RUN_ENV =
else
RUN_ENV = PHASE_RUN_ID="$(RUN_ID)"
endif

ifeq ($(strip $(REARCH_ID)),)
REARCH_ENV =
else
REARCH_ENV = REARCH_ID="$(REARCH_ID)"
endif

.PHONY: help harness-help phase-2-5 phase-3-5 phase-3 phase-4 phase-5 phase-6 phase-7 phase-7-serial phase-7-dry-run phase-7-notes phase-ra-3 phase-ra-4 phase-ra-5 phase-ra-6 phase-ra-complete phase-ra-abandon watch status

help harness-help:
	@echo "AI Product Slice Harness targets:"
	@echo "  HARNESS_COMMIT_DIRTY=1 make phase-2-5 Commit Phase 02, then run/commit 03–05"
	@echo "  make phase-3-5                       Run and commit Phases 03–05 in order"
	@echo "  make phase-3                         Run Phase 03 product-spec agents"
	@echo "  make phase-4                         Run Phase 04 customer-request agents"
	@echo "  make phase-5                         Run Phase 05 producer-response agents"
	@echo "  PHASE_CONFIRMED=1 make phase-6       Run gated Phase 06 first implementation"
	@echo "  make phase-7                         Run Phase 07 iteration"
	@echo "  make phase-7-serial                  Run Phase 07 one product at a time"
	@echo "  make phase-7-dry-run                 Preview unresolved Phase 07 specs"
	@echo "  make phase-7-notes                   Regenerate version-history notes"
	@echo "  make phase-ra-3 .. phase-ra-5        Re-architecture planning agents"
	@echo "  PHASE_CONFIRMED=1 make phase-ra-6    Gated re-architecture implementation"
	@echo "  PHASE_CONFIRMED=1 make phase-ra-complete"
	@echo "  make phase-ra-abandon                Mark selected re-architecture abandoned"
	@echo "  make watch                           Keep watching and follow active phases"
	@echo "  make watch PHASE=phase-06-first-implementation"
	@echo "                                       Keep watching one named phase"
	@echo "  make status                          Show latest run status for PHASE=$(PHASE)"
	@echo ""
	@echo "Variables: PHASE, RUN_ID, REARCH_ID, LINES, INTERVAL, ARGS, PHASE_ONLY, HARNESS_COMMIT_DIRTY"

phase-2-5:
	@echo "=========================================="
	@echo "Phase 02–05: Commit Phase 02, then run/commit 03–05"
	@echo "=========================================="
	@echo ""
	@echo "This target would run Phases 03, 04, and 05 in sequence using Codex."
	@echo "This repository uses Cursor Cloud Agents instead."
	@echo ""
	@echo "Manual workflow:"
	@echo "  1. Commit Phase 02 scaffold to this branch"
	@echo "  2. Run Phase 03 manually (see 'make phase-3' for prompts)"
	@echo "  3. After Phase 03 completes, merge to main"
	@echo "  4. Run Phase 04 manually (see 'make phase-4' for prompts)"
	@echo "  5. After Phase 04 completes, merge to main"
	@echo "  6. Run Phase 05 manually (see 'make phase-5' for prompts)"
	@echo "  7. After Phase 05 completes, merge to main"
	@echo ""
	@echo "ERROR: This repository uses Cursor Cloud Agents, not Codex."
	@echo "Do NOT run 'codex exec'. Launch Cursor Cloud Agents manually instead."
	@echo ""
	@exit 1

