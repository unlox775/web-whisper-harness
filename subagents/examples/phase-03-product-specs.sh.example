#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/docs/ai-product-slice-harness/subagent-runner.sh"

start_phase "phase-03-product-specs"
set_phase_context "$*"

enqueue_product_spec_agent "packages/hunt-session-engine"
enqueue_product_spec_agent "packages/journal-data-library"
enqueue_product_spec_agent "packages/reference-capture-interface"
enqueue_product_spec_agent "packages/timeline-viewer"
enqueue_product_spec_agent "apps/final-ios-app"

# Default: run the queued agents in parallel.
# To rerun one at a time, comment the parallel line and uncomment the serial line.
run_enqueued_agents_in_parallel
# run_enqueued_agents_one_at_a_time
