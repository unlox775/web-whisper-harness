{
  "name": "web-whisper-pwa",
  "version": "1.0.0",
  "description": "User-facing Progressive Web App for iPhone. Owns navigation, UI screens (home, session list, session detail, settings, developer mode), platform permissions (microphone), settings persistence, and orchestration of the lib packages and session-store.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "vite"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@web-whisper/session-store": "workspace:*",
    "@web-whisper/capture-engine": "workspace:*",
    "@web-whisper/volume-analyzer": "workspace:*",
    "@web-whisper/transcription-client": "workspace:*",
    "@web-whisper/playback-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.17.0"
  }
}
